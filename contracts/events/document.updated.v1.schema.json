      "const": "document.updated"
    },
    "schema_version": {
      "const": "v1"
    },
    "aggregate_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["document_id", "status"],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "document_type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
